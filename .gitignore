# Binaries for programs and plugins (except in temp/)
!temp/*.exe
!temp/*.log
!tmp/*.exe
!tmp/*.log

tmp/
*.exe~
*.dll
*.so
*.dylib
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (often used with vendoring tools)
vendor/
Godeps/

# Node.js dependencies and logs inside client folder only
client/node_modules/
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/pnpm-debug.log*

# Lock files inside client folder only
client/package-lock.json
client/yarn.lock
client/pnpm-lock.yaml

# IDE/editor settings
.vscode/
.idea/
*.swp

# Build directories
bin/
build/
dist/

# OS generated files
.DS_Store
Thumbs.db

# Go workspace file
go.work
go.work.sum

# Ignore .env files
.env
.env.*

# Ignore exe and log files globally except inside temp/
*.exe
*.log
!temp/*.exe
!temp/*.log

*.tsbuildinfo
